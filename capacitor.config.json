{
  "appId": "com.osmanadali.hamur",
  "appName": "Hamur",
  "webDir": "www",
  "backgroundColor": "#c59af1",
  "loggingBehavior": "none",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 3000,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#c59af1",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
